{
  "name": "levoshina-realtor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "dev": "npm run assets && vite --host 127.0.0.1",
    "check": "tsc --noEmit && tsx scripts/validate-content.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run assets && npm run check && vite build",
    "build:release": "tsx scripts/validate-content.ts --release && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:content": "tsx --test tests/content.test.ts",
    "images": "node scripts/optimize-images.mjs",
    "test:images": "node --test tests/images.test.mjs",
    "assets": "tsx scripts/generate-og.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
